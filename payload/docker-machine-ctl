#!/bin/sh
# docker-machine-ctl — the command surface the menu-bar app drives. Sources the shared
# helpers; every state-changing verb re-announces via write_state.
set -u
. "${MAVERICKS_DOCKER_COMMON:-/usr/local/libexec/modernmavericks/docker/docker-machine-common.sh}"

_run_and_announce() { # docker-machine subcommand
  docker-machine "$1" "$MACHINE" >>"$LOG" 2>&1
  _rc=$?
  # A start/restart can bring the VM up on a new DHCP IP; re-point the context so the menu path
  # self-heals too (not only the login-agent timer). Only once the VM is actually up.
  case "$1" in start|restart) [ "$(machine_status)" = Running ] && sync_context ;; esac
  write_state "$(status_word)"
  return $_rc
}

case "${1:-}" in
  status)  _w=$(status_word); write_state "$_w"; echo "$_w" ;;
  start)   _run_and_announce start ;;
  stop)    _run_and_announce stop ;;
  restart) _run_and_announce restart ;;
  image-status) image_status ;;
  # Roll the VM onto the freshly-installed boot2docker.iso. Repoint first (a migrated host's stale
  # Boot2DockerURL would make `docker-machine upgrade` fail fetching the vanished DMG), then upgrade
  # (data disk preserved), then bring it up + heal the context. CLI-only; the menu drives this verb.
  image-upgrade)
    repoint_iso_url
    docker-machine upgrade "$MACHINE" >>"$LOG" 2>&1 || true
    _run_and_announce start ;;
  login-status) launchctl list "$AGENT_LABEL" >/dev/null 2>&1 && echo on || echo off ;;
  login-on)  launchctl load -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  login-off) launchctl unload -w "$AGENT_PLIST" >>"$LOG" 2>&1 ;;
  setup)   exec docker-machine-bootstrap ;;
  migrate) exec docker-machine-migrate ;;
  vmx-pid) pgrep -f "machines/$MACHINE/.*\.vmx" 2>/dev/null | head -1 || true ;;
  *) echo "usage: docker-machine-ctl {status|start|stop|restart|image-status|image-upgrade|login-status|login-on|login-off|setup|migrate|vmx-pid}" >&2; exit 2 ;;
esac
